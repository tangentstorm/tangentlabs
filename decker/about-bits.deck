{script:physical.0}
on run text do result.data: eval[text 0 1] end

on mid wid do wid.pos + wid.size / 2 end

on click do
 me.show: if me.show="solid" "invert" else "solid" end
end

on view do
 c.pos:0,0 c.size:card.size c.locked:1 c.clear[] c.pattern: 45
 each e in rows edges.value
  src: card.widgets[e.src]  dst: card.widgets[e.dst]
  c.line[mid[src] mid[dst]]
 end
end
{end}

{script:physical.1}
on click pos do
 # nothing, so we don't trigger the invert
end

on drag pos do

end

on release pos do

end
{end}

{card:byte}
script:"byte.0"
{widgets}
notes:{"type":"field","size":[452,96],"pos":[24,230],"script":"byte.1","pattern":42,"style":"plain","value":"8 bits make a byte. You can think of it as a number between 0..255 inclusive.\n"}
c:{"type":"canvas","size":[170,43],"pos":[32,42],"image":"%%","scale":1}
slider2:{"type":"slider","size":[128,25],"pos":[343,60],"interval":[0,255],"style":"compact"}
slider1:{"type":"slider","size":[100,25],"pos":[357,60],"interval":[0,255],"format":"%02H","style":"bar"}
state:{"type":"field","size":[100,20],"pos":[345,112],"value":"0"}

{script:byte.0}
on run text do eval[text 0 1] end

on change do
 slider1.value: slider2.value: state.data:me.value
 view[]
end

on view do
 c.clear[]   z:16  v:state.data
 each i in range 8
   x:z*i  b:if bits.and[v 2^7-i] 1 else 0 end
   c.pattern: 1-b  c.rect[x,0  z,z]
   c.pattern: b  c.text[b (x,0)+6,4]
   c.pattern:1 c.box[x,0 1+z,z]
 end
end

{end}

{script:byte.1}
on change val do

end
{end}

