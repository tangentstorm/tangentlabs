{script:4. parallax.0}
W:c.size[0] H:c.size[1] N:100

on rnd k do
 random@ N take k
end

on rebuild do
 g.value:
  select
   x:rnd[W] y:rnd[H]
   p:32+rnd[16] b:rnd[5]
  from nil
end

on view do
 g.value: update x:x+b+1 from g.value
 c.pattern:1 c.rect[0 c.size]
 each s in rows g.value
  c.pattern:s.p c.brush:s.b
  c.line[s.x,s.y]
 end
end

on loop do
 # just for this one card, since otherwise
 # the stars fly off to the right forever 
 rebuild[] send loop[]
end
{end}

