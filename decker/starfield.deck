{deck}
version:1
card:3
size:[512,342]
script:"0"
name:"starfield.deck"

{script:0}
# -- palette tools ---------------------------
on save_pal do
 " " fuse (list "%h") format patterns@32+range 16
end

on load_pal p do
 each c i in (list "%h") parse " " split p
  deck.patterns[32+i]:c
 end
end

# loop event runs when you navigate cards or
# when the audio loop needs to refresh. we're
# not using audio loops, but will hook in here
# to change the palette. Trick is to create a
# field widget named "palette" with the name of
# one of the palettes below.
on loop do
 p:deck.card.widgets.palette.text
 if p in keys pal 
  load_pal[pal[p]]
 end
 0 # return 0 to indicate there's no audio to play
end

# -- palettes used in this deck -------------
pal: ()
pal.decker: # default decker palette
 "ffffff ffff00 ff6500 dc0000 ff0097 360097 ca 97ff a800 6500 653600 976536 b9b9b9 868686 454545 0"

pal.pastelpop: # https://lospec.com/palette-list/pastel-pop-16-color
 "fffcff e6e1f2 b2b7e1 595b7d 7b8ac6 ffd9f4 e1adc3 ad80a6 fba2d7 fae0c7 f0abab 97c4aa bfedf5 73c9eb caaff5 0"
 
pal.arne: # https://lospec.com/palette-list/arne-16
 "ffffff 493c2b be2633 e06f8b 9d9d9d a46422 eb8931 f7e26b 1b2632 2f484e 44891a a3ce27 5784 31a2f2 b2dcef 0"
 
pal.ate: # https://lospec.com/palette-list/ate
 "e8f8f8 f8b888 f88e89 e86878 985898 488888 48bd68 d8e888 a8b8f8 8484f8 484888 4868e8 68a8e8 f8b8c8 f889c8 162432"
{end}

