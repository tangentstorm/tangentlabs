{deck}
version:1
card:3
size:[512,342]
script:"0"
name:"starfield.deck"

{script:0}
# -- palette tools ---------------------------
on save_pal do
 " " fuse (list "%h") format patterns@32+range 16
end

on load_pal p do
 each c i in (list "%h") parse " " split p
  deck.patterns[32+i]:c
 end
end

# loop event runs when you navigate cards or
# when the audio loop needs to refresh. we're
# not using audio loops, but will hook in here
# to change the palette. Trick is to create a
# field widget named "palette" with the name of
# one of the palettes below.
on loop do
 p:deck.card.widgets.palette.text
 if p in keys pal 
  load_pal[pal[p]]
 end
 0 # return 0 to indicate there's no audio to play
end

# -- palettes used in this deck -------------
pal: ()
pal.decker: # default decker palette
 "ffffff ffff00 ff6500 dc0000 ff0097 360097 ca 97ff a800 6500 653600 976536 b9b9b9 868686 454545 0"

pal.pastelpop: # https://lospec.com/palette-list/pastel-pop-16-color
 "fffcff e6e1f2 b2b7e1 595b7d 7b8ac6 ffd9f4 e1adc3 ad80a6 fba2d7 fae0c7 f0abab 97c4aa bfedf5 73c9eb caaff5 0"
 
pal.arne: # https://lospec.com/palette-list/arne-16
 "ffffff 493c2b be2633 e06f8b 9d9d9d a46422 eb8931 f7e26b 1b2632 2f484e 44891a a3ce27 5784 31a2f2 b2dcef 0"
 
pal.ate: # https://lospec.com/palette-list/ate
 "e8f8f8 f8b888 f88e89 e86878 985898 488888 48bd68 d8e888 a8b8f8 8484f8 484888 4868e8 68a8e8 f8b8c8 f889c8 162432"
{end}

{card:final}
script:"final.0"
{widgets}
c:{"type":"canvas","size":[512,342],"pos":[0,0],"locked":1,"animated":1,"volatile":1,"pattern":39,"border":0,"brush":3,"scale":1}
g:{"type":"grid","size":[235,89],"pos":[6,49],"volatile":1,"script":"final.1","show":"none"}
rebuildBtn:{"type":"button","size":[60,20],"pos":[6,144],"script":"final.2","show":"none","text":"rebuild","shortcut":"r"}
uiBtn:{"type":"button","size":[61,20],"pos":[180,144],"script":"final.3","font":"body","pattern":37,"style":"invisible","value":0,"shortcut":"u"}
speed:{"type":"slider","size":[60,13],"pos":[181,29],"show":"none","interval":[0,20],"value":3,"format":"speed: %f","style":"bar"}
palette:{"type":"field","size":[100,20],"pos":[401,26],"locked":1,"show":"none","value":"pastelpop"}
pauseBtn:{"type":"button","size":[60,20],"pos":[98,144],"script":"final.4","show":"none","text":"pause","shortcut":"p"}

{script:final.0}
# canvas c covers the whole card.
# N is "number of stars"
C:c.size/2 W:c.size[0] H:c.size[1] N:500

# grid g contains the data for each star.

# rnd[x] generates a random column of numbers between 0 and x
on rnd x do random@ N take x end

# clicking the button triggers this rebuild.
# x,y : position
# z   : velocity/brush number
# p   : pattern (color) used to draw the star
on rebuild do
 g.value:
  select
   x: rnd[W]-W/2 y:rnd[H]-H/2
   b:rnd[2] p:32+rnd[16]
   z:rnd[W] # W serves double duty as depth of the frustum
  from nil
end

# widget c is marked as "animated" so decker issues
# a "view" event 60 times a second.
on view do
  # -- "physics" ----------------------------
  # store table in local variable so it's easier to work with:
  t:g.value

  t.pz: t.z
  t.z: t.z - speed.value
  t: update pz:W z:W x:rnd[W]-W/2 y:rnd[H]-H/2 p:32+rnd[16] 
     where z<1 from t

  # change the brush dynamically as we get closer to camera
  t.b: floor lerp[5 0 t.z/W]

  # save the data back to the grid widget so we can find it next frame:
  g.value:t
  
  # extra columns for the previous and current SCREEN position of each star
  t.pxy: lerp[0 W t.x/t.pz] join lerp[0 H t.y/t.pz]
  t.txy: lerp[0 W t.x/t.z] join lerp[0 H t.y/t.z]

  # -- drawing -----------------------------
  # fill canvas with pattern 1 (solid black)
  c.pattern:1 c.rect[0 c.size]
  each s in rows t
    c.pattern: s.p c.brush: s.b
    c.line[s.pxy+C s.txy+C]
  end
end

on lerp a b t do a + (b-a)*t end

on navigate dir do
 if dir="up" speed.value: speed.value+1
 elseif dir="down" speed.value: speed.value-1
 else send navigate[dir] end
end

{end}

{script:final.1}
on click row do
 # nothing. just stop canvas click from rebuilding stars
end
{end}

{script:final.2}
on click do
 rebuild[]
end
{end}

{script:final.3}
on click do
 (f,g,speed,rebuildBtn,pauseBtn)..toggle["solid"]
 deck.locked:!deck.locked
end
{end}

{script:final.4}
on click do
 c.animated:!c.animated
end
{end}

