{deck}
version:1
card:1
size:[512,342]
script:"0"
name:"toolbox.deck"

{script:0}
# toolbox

on l ...xs do xs end # list constructor
on fac n do prod n-range n end # factorial
on nck n k do (prod n-range k) / fac[k] end # n choose k

on navigate dir do  help:"help" fc:15 # frame count
 if   (dir="down") &! deck.card.name=help go[help "SlideUp" fc]
 elseif (dir="up") & deck.card.name=help go["Back" "SlideDown" fc]
 elseif dir="left" go["Prev" "SlideRight" fc]
 elseif dir="right" go["Next" "SlideLeft" fc] end
end

on run text do
 d:deck.card.widgets
 d.card:deck.card
 r:eval[deck.card.script d 1]
 if r.error
  alert[r.error]
 else
  d:r.vars
  r:eval[text d 1]
 end
 if "res" in keys d
   d.res.data: r.value unless r.error
 end
end

{end}

