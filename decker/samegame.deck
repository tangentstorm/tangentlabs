{script:help.0}
on set_pattern x do
 (pal,patternSlider)..value:x
 (c0,c1)..pattern: x
end

on set_brush x do
 (brush,brushSlider)..value: x
 (c0,c1)..brush:x
end

on view do
 set_pattern[1]
 set_brush[0]
end
{end}

{script:help.1}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  c.pattern:i c.rect[cwh*xy cwh]
 end
end

on pick xy i do
 set_pattern[i]
end
{end}

{script:help.2}
on change val do
 set_pattern[val]
end
{end}

{script:help.3}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  # .line[single_point] = draw brush
  c.brush:i c.line[cwh*xy+.5]
 end
end

on pick xy val do
 set_brush[val]
end
{end}

{script:help.4}
on change val do
 set_brush[val]
end
{end}

{script:help.5}
on click do
 go["Back" "SlideDown" 15]
end
{end}

{module:plot}
description:"draw graphs and plots to canvases"
version:2.2
{script}
local grays:(1,13,12,9,8,5)

on label x y do
 # Paul Heckbert's "loose labels" method
 # for generating axis labels and ranges:
 on nice x round do
  f:x/10^e:floor(ln x)/(ln n:10)
  if round
   if f<7   n:5 end
   if f<3   n:2 end
   if f<1.5 n:1 end
  else
   if !f>5  n:5 end
   if !f>2  n:2 end
   if !f>1  n:1 end
  end
  n*10^e
 end
 d:nice[nice[y-x 0]/5 1]
 a:d*floor x/d
 b:d*ceil  y/d
 v:() while a<b+.5*d  v:v,a  a:a+d end v
end

on plot_series c data draw etc do
 c.font:      if "font"   in etc etc.font   else "body" end
 local margin:if "margin" in etc etc.margin else     10 end
 local bg    :if "bg"     in etc etc.bg     else      0 end
 local bgdata:if "bgdata" in etc etc.bgdata else      0 end
 local stroke:if "stroke" in etc etc.stroke else      1 end
 local fillp :if "fill"   in etc etc.fill   else  grays end
 if "number"~typeof fillp fillp:list fillp end

 if !"table"~typeof data
  data:select x:keys data y:value from data
 end
 nd.x:if "x" in data data.x else (update x:gindex by g from data).x end
 nd.y:if "y" in data data.y else data end
 nd.g:if "g" in data data.g else 0*nd.x end
 data:update g:group by g from table nd

 xaxis:label[
  if "xmin" in etc etc.xmin else min data.x end
  if "xmax" in etc etc.xmax else max data.x end
 ]
 yaxis:label[
  if "ymin" in etc etc.ymin else min data.y end
  if "ymax" in etc etc.ymax else max data.y end
 ]
 gmin:(first xaxis),first yaxis
 gmax:(last  xaxis),last  yaxis
 axes:(max each x in yaxis c.font.textsize[x][0] end),12
 psize:c.lsize-axes+2*margin
 ppos:margin+axes*1,0

 c.pattern:bg
 c.rect[0,0 c.size]
 c.pattern:bgdata
 c.rect[ppos psize]

 c.pattern:stroke
 c.brush:0
 c.rect[ppos+psize*0,1  psize[0],1]
 c.rect[ppos+psize*0,1  1,-psize[1]]
 on map pos do
  r:(pos-gmin)/gmax-gmin
  ppos+psize*r[0],1-r[1]
 end
 each v in xaxis
  p:map[v,first yaxis]
  c.rect[p 1,3]
  c.text[v p+0,5 "top_center"]
 end
 each v in yaxis
  p:map[(first xaxis),v]
  c.rect[p -3,1]
  c.text[v p-5,0 "center_right"]
 end
 c.clip[ppos-0,1 psize+1]
 extract
  (c.pattern:fillp[(count fillp)%first g]),
  draw[each v i in x map[v,y[i]] end]
 by g from data
 c.clip[]
end

on plot_category c data line draw etc do
 c.font:      if "font"   in etc etc.font   else  "body" end
 local margin:if "margin" in etc etc.margin else      10 end
 local bg    :if "bg"     in etc etc.bg     else       0 end
 local bgdata:if "bgdata" in etc etc.bgdata else       0 end
 local stroke:if "stroke" in etc etc.stroke else       1 end
 local fillp :if "fill"   in etc etc.fill   else list 13 end
 if "number"~typeof fillp fillp:list fillp end

 xaxis:label[
  if "xmin" in etc etc.xmin else min 0,min data end
  if "xmax" in etc etc.xmax else max 0,max data end
 ]
 gmin:first xaxis
 gmax:last  xaxis
 axes:(max each v k in data c.font.textsize[k][0] end),12
 psize:c.lsize-axes+2*margin
 ppos:margin+axes*1,0

 c.pattern:bg
 c.rect[0,0 c.size]
 c.pattern:bgdata
 c.rect[ppos psize]

 c.pattern:stroke
 c.brush:0
 c.rect[ppos+psize*0,1 psize[0],1]
 on mapx x do ppos[0]+psize[0]*(x-gmin)/gmax-gmin end
 each v in xaxis
  p:mapx[v],(ppos+psize)[1]
  c.rect[p 1,3]
  c.text[v p+0,5 "top_center"]
 end
 origin:mapx[0]
 yaxis:origin,ppos[1]
 c.pattern:line
 c.rect[yaxis 1,psize[1]]

 bh:psize[1]/count data
 each v k i in data
  p:ppos+(0,1)*(bh*i)+bh/2
  c.pattern:stroke
  c.text[k p-5,0 "center_right"]
  c.pattern:fillp[(count fillp)%i]
  c.clip[ppos-0,1 psize+1]
  draw[origin,p[1] each x in (),v mapx[x] end bh]
  c.clip[]
 end
end

on plot_scatter c data etc do
 local data_brush:if "brush" in etc etc.brush else 3 end
 on draw d do
  c.brush:data_brush
  each v in d c.line[v] end
 end
 plot_series[c data draw etc]
end

on plot_line c data etc do
 local data_brush:if "brush" in etc etc.brush else 1 end
 on draw d do
  c.brush:data_brush
  c.line[d]
 end
 plot_series[c data draw etc]
end

on plot_hist c data etc do
 c.font:      if "font"   in etc etc.font   else  "body" end
 local margin:if "margin" in etc etc.margin else      10 end
 local bg    :if "bg"     in etc etc.bg     else       0 end
 local bgdata:if "bgdata" in etc etc.bgdata else       0 end
 local stroke:if "stroke" in etc etc.stroke else       1 end
 local fillp :if "fill"   in etc etc.fill   else list 13 end
 if "number"~typeof fillp fillp:list fillp end

 xdata:range count data
 xaxis:label[min xdata max xdata]
 yaxis:label[
  if "ymin" in etc etc.ymin else min data end
  if "ymax" in etc etc.ymax else max data end
 ]
 if 5>count data xaxis:xdata end
 gmin:(  first xaxis),first yaxis
 gmax:(1+last  xaxis),last  yaxis
 axes:(max each x in yaxis c.font.textsize[x][0] end),12
 psize:c.lsize-axes+2*margin
 ppos:margin+axes*1,0
 bwid:psize[0]/count data

 c.pattern:bg
 c.rect[0,0 c.size]
 c.pattern:bgdata
 c.rect[ppos psize]

 c.brush:0
 c.clip[ppos-0,1 psize+1]
 on map pos xoff do
  r:(pos-gmin)/gmax-gmin
  (xoff,0)+ppos+psize*r[0],1-r[1]
 end
 each v i in data
  v:map[i,v bwid/2]
  s:1+psize[1]-v[1]-ppos[1]
  c.pattern:fillp[(count fillp)%i]
  c.rect[v 1+bwid,s "top_center"]
 end
 c.clip[]
 c.pattern:stroke
 c.rect[ppos+psize*0,1  psize[0],1]
 c.rect[ppos+psize*0,1  1,-psize[1]]
 each v in xaxis
  p:map[v,first yaxis bwid/2]
  c.rect[p 1,3]
  c.text[v p+0,5 "top_center"]
 end
 each v in yaxis
  p:map[(first xaxis),v]
  c.rect[p -3,1]
  c.text[v p-5,0 "center_right"]
 end
end

on plot_bar c data etc do
 local stroke:if "stroke" in etc etc.stroke else 1 end
 local axes:  if "axes"   in etc etc.axes   else 1 end
 on draw start stops height do
  a:start-height*0,.4
  b:((first stops)-start[0]),.8*height
  c.rect[a b]
  c.pattern:stroke
  c.box[a b]
 end
 plot_category[c data axes draw etc]
end

on plot_box c data etc do
 local stroke:if "stroke" in etc etc.stroke else 1 end
 on draw start stops height do
  on stop x do floor stops[x],start[1] end
  on woff x do (1+x),height*.5         end
  a:stop[0]
  b:stop[-1+count stops]
  local col:c.pattern
  c.pattern:stroke
  c.line[a b]
  c.rect[a woff[] "center_left"]
  c.rect[b woff[] "center_left"]
  c.pattern:col
  if 2<count stops
   m:0.5*count stops
   q1:stop[m-1] q2:stop[m] q3:stop[m+1]
   c.rect [q1 woff[q3[0]-q1[0]] "center_left"]
   c.pattern:stroke
   c.box  [q1 woff[q3[0]-q1[0]] "center_left"]
   c.rect [q2 woff[           ] "center_left"]
  end
 end
 if !"fill" in etc etc.fill:32 end
 plot_category[c data 18 draw etc]
end

on plot_pie c data etc do
 local margin    :if "margin" in etc etc.margin else    10 end
 local bg        :if "bg"     in etc etc.bg     else     0 end
 local data_brush:if "brush"  in etc etc.brush  else     1 end
 local stroke    :if "stroke" in etc etc.stroke else     1 end
 local fillp     :if "fill"   in etc etc.fill   else grays end
 if "number"~typeof fillp fillp:list fillp end
 
 local vals:(range data)/sum range data
 local psize:c.lsize-2*margin
 local radius:.5*min psize
 local center:margin+psize/2
 
 c.pattern:bg
 c.rect[0,0 c.size]
 c.brush:data_brush
 local start:0
 on wedge v do
  r:radius*unit -2*pi*start+v*(range 21)/20
  start:start+v
  (list center),(flip center+flip r),(list center)
 end
 each v i in vals
  local w:wedge[v]
  c.pattern:fillp[(count fillp)%i]
  c.poly[w]
  c.pattern:stroke
  c.line[w]
 end
end

on unpivot key value src tab do
 eval["select
  %s
  %v:src
  %v:raze column@src
 by index from tab" format (" " fuse src drop keys tab),key,value () 1].value
end
on pivot key value tab do
 keep:(key,value) drop keys tab
 dkey:keys tab[key] dict ()
 head:(" ","%q:first %v") format keep join keep
 data:(" ","%q:%s[%i]"  ) format dkey join ((count dkey) take list value) join (keys dkey)
 ident:" join " fuse keep
 eval["select %s %s by %s from tab" format head,data,ident () 1].value
end

mod.label  :label
mod.unpivot:unpivot
mod.pivot  :pivot
mod.scatter:plot_scatter
mod.line   :plot_line
mod.hist   :plot_hist
mod.bar    :plot_bar
mod.box    :plot_box
mod.pie    :plot_pie
{end}

{contraption:tutor}
size:[512,160]
resizable:1
margin:[5,140,4,8]
description:"A contraption for creating interactive decker tutorials.\n\nchangelog\n0.3: add help config, scrolling, resize and recolor\n0.2: add help button \n0.1: initial version"
version:0.3
image:"%%"
script:"tutor.0p"
attributes:{"name":["body","scroll_body","code","scroll_code","next","prev","help"],"label":["body","scroll body","code","scroll code","next card","prev card","help card"],"type":["rich","bool","code","bool","string","string","string"]}
{widgets}
body:{"type":"field","size":[210,124],"pos":[3,33],"locked":1,"pattern":44,"show":"transparent","border":0,"scrollbar":0,"value":"..."}
nextBtn:{"type":"button","size":[60,20],"pos":[445,35],"script":"tutor.1p","pattern":39,"text":"next>","style":"rect"}
cardName:{"type":"field","size":[504,20],"pos":[3,7],"locked":1,"volatile":1,"font":"menu","show":"transparent","border":0,"style":"plain"}
code:{"type":"field","size":[218,125],"pos":[222,32],"pattern":47,"show":"none","border":1,"scrollbar":0,"style":"code","scroll":1}
prevBtn:{"type":"button","size":[60,20],"pos":[445,58],"script":"tutor.2p","pattern":39,"text":"<prev","style":"rect"}
runBtn:{"type":"button","size":[60,20],"pos":[445,105],"script":"tutor.3p","pattern":0,"show":"none","text":"run","style":"rect"}
next:{"type":"field","size":[100,20],"pos":[4,-31],"locked":1,"show":"none","style":"plain","value":"Next"}
prev:{"type":"field","size":[100,20],"pos":[121,-31],"locked":1,"show":"none","style":"plain","value":"Prev"}
helpBtn:{"type":"button","size":[60,20],"pos":[445,81],"script":"tutor.4p","pattern":39,"show":"none","text":"help","style":"rect"}
help:{"type":"field","size":[100,20],"pos":[239,-31],"locked":1,"show":"none","style":"plain"}
scroll_body:{"type":"button","size":[15,20],"pos":[5,175],"locked":1,"show":"none","style":"check","value":0}
scroll_code:{"type":"button","size":[15,20],"pos":[80,175],"locked":1,"show":"none","style":"check","value":0}

{script:tutor.0p}
on get_body do body.value end  on set_body x do body.value: x end
on get_code do code.text end   on set_code x do code.text: x end
on get_next do next.text end   on set_next x do next.text: x end
on get_prev do prev.text end   on set_prev x do prev.text: x end
on get_help do help.text end   on set_help x do help.text: x end
on get_scroll_code do scroll_code.value end
on get_scroll_body do scroll_body.value end
on set_scroll_code x do scroll_code.value:x end
on set_scroll_body x do scroll_body.value:x end

on view do
 cardName.text: deck.card.name
 code.scrollbar: scroll_code.value
 body.scrollbar: scroll_body.value
 code.locked: me.locked
 sh: if code.text
       if me.locked "invert" else "solid" end
     else "none" end
 code.show: sh runBtn.show: sh
 nextBtn.show: if next.text "solid" else "none" end
 prevBtn.show: if prev.text "solid" else "none" end
 helpBtn.show: if help.text "solid" else "none" end
end

on next_card_name do
 if next.text = "Next"
  cn:keys deck.cards
  ci:first extract index where value=deck.card.name from cn
  cn[ci+1]
 else
  next.text
 end
end

on no_script c do
 (c.script="on view do\n\nend") |!c.script
end

on is_special c do
 "special" in keys c.widgets
end

on copy_to_next do
 card: deck.card
 if !is_special[card]
  nc: deck.cards[next_card_name[]]
  if !is_special[nc]
   tw: "tutor1"
   if ! count tw drop nc.widgets
    each w in tw drop card.widgets nc.add[w] end
   end
   if no_script[nc] nc.script: card.script end
  end
 end
end

on run text do
 d:deck.card.widgets
 d.card: deck.card
 eval[text d 1]
end

{end}

{script:tutor.1p}
on click do
 copy_to_next[]
 go[next.text "SlideLeft" 15]
end
{end}

{script:tutor.2p}
on click do
 go[prev.text "SlideRight" 15]
end
{end}

{script:tutor.3p}
on click do
 d:deck.card.widgets
 d.card:deck.card
 eval[code.text d 1]
end

{end}

{script:tutor.4p}
on click do
 go["help" "SlideUp" 15]
end
{end}

{contraption:cardName}
size:[100,20]
resizable:1
margin:[0,0,0,0]
description:"show / edit the current card name"
script:"cardName.0p"
{widgets}
cn:{"type":"field","size":[100,20],"pos":[0,0],"show":"transparent","border":0,"style":"plain","value":"card7"}

{script:cardName.0p}
on view do
 cn.text: deck.card.name
end

on change val do
 deck.card.name: cn.text
end
{end}

{contraption:hybridSlider}
size:[100,25]
margin:[19,6,17,6]
description:"Provides a slider with a combination of the \"bar\" and \"compact\" styles."
script:"hybridSlider.0p"
template:"on change val do\n \nend"
attributes:{"name":["minv","maxv","format","value"],"label":["min value","max value","format","value"],"type":["number","number","string","number"]}
{widgets}
compact:{"type":"slider","size":[100,25],"pos":[0,0],"script":"hybridSlider.1p","interval":[0,100],"style":"compact"}
bar:{"type":"slider","size":[74,25],"pos":[13,0],"script":"hybridSlider.2p","interval":[0,100],"style":"bar"}

{script:hybridSlider.0p}
on get_value do bar.value end       on set_value x do bar.value: x end
on get_format do bar.format end     on set_format x do bar.format: x end
on get_minv do bar.interval[0] end  on set_minv x do bar.interval:x,get_minv[] end
on get_maxv do bar.interval[1] end  on set_maxv x do bar.interval:get_maxv[],x end

on view do
 compact.interval: bar.interval
 compact.value:bar.value
end

{end}

{script:hybridSlider.1p}
on change val do
 bar.value:val
 card.event["change" val]
end

{end}

{script:hybridSlider.2p}
on change val do
 compact.value:val
 card.event["change" val]
end

{end}

{contraption:gridSelector}
size:[128,128]
resizable:1
margin:[2,1,2,2]
description:"Draws a rectangular grid with a cursor, and translates mouse events to grid coordinates."
version:0.1
script:"gridSelector.0p"
attributes:{"name":["cw","ch","gc","gw","gh","cursor"],"label":["cell width","cell height","grid color","grid width","grid height","draw cursor?"],"type":["number","number","number","number","number","bool"]}
{widgets}
cellW:{"type":"slider","size":[54,25],"pos":[158,-46],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
cellH:{"type":"slider","size":[54,25],"pos":[158,-3],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
c:{"type":"canvas","size":[128,128],"pos":[0,0],"locked":1,"volatile":1,"pattern":32,"show":"transparent","border":1,"scale":1}
gridColor:{"type":"slider","size":[54,25],"pos":[158,40],"locked":1,"interval":[0,47],"value":9,"style":"compact"}
curXY:{"type":"field","size":[61,20],"pos":[158,81],"locked":1,"style":"plain","value":"[2,1]"}
gridW:{"type":"slider","size":[54,25],"pos":[224,-46],"locked":1,"interval":[1,1024],"value":16,"style":"compact"}
gridH:{"type":"slider","size":[54,25],"pos":[224,-3],"locked":1,"interval":[1,1024],"value":16,"style":"compact"}
showCursor:{"type":"button","size":[60,20],"pos":[225,40],"locked":1,"font":"body","text":"cursor?","style":"check","value":1}

{script:gridSelector.0p}
on get_cw do cellW.value end     on set_cw x do cellW.value: x end
on get_ch do cellH.value end     on set_ch x do cellH.value: x end
on get_gw do gridW.value end     on set_gw x do gridW.value: x end
on get_gh do gridH.value end     on set_gh x do gridH.value: x end
on get_gp do gridP.value end     on set_gp x do gridP.value: x end
on get_showCursor   do showCursor.value   end
on set_showCursor x do showCursor.value:x end

on get_cxy do curXY.data end       on set_cxy xy do curXY.data: xy end
on get_cwh do cellW.value,cellH.value end
on get_value do (get_gw[] * last curXY.data) + first curXY.data end
on set_value i do
 gw:get_gw[] curXY.data: (gw%i),(floor i/gw)
 view[]
end
  
on view do
 c.clear[] c.brush:0 c.pattern:1
 # give instances a chance to draw on canvas
 card.event["draw" c] c.brush:0 c.pattern: gridColor.value
 if gridColor.value
  each x in get_cw[] * range 1+get_gw[] c.line[x,0 x,c.size[1]] end nil
  each y in get_ch[] * range 1+get_gh[] c.line[0,y c.size[0],y] end nil
 end
 if showCursor.value
  xy:curXY.data  cwh:get_cwh[]
  c.brush: c.pattern:1  c.box[xy*cwh 1+cwh]
  c.brush: 0 c.pattern:32 c.box[xy*cwh cwh]
 end
end
on drag xy do click[xy] end
on click xy do
 set_cxy[floor xy/get_cwh[]]
 view[]
 card.event["pick" get_cxy[] get_value[]]
end
{end}

