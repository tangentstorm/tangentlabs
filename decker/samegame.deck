cardName1:{"type":"contraption","size":[132,14],"pos":[23,19],"def":"cardName","widgets":{"cn":{"size":[132,14],"value":"same game"}}}
prevBtn:{"type":"button","size":[20,15],"pos":[0,18],"script":"same game.1","font":"body","text":"<<"}
nextBtn:{"type":"button","size":[20,15],"pos":[157,18],"script":"same game.2","font":"body","text":">>"}
newBtn:{"type":"button","size":[20,15],"pos":[236,18],"script":"same game.3","font":"body","text":"+"}
c:{"type":"canvas","size":[160,160],"pos":[272,32],"locked":1,"pattern":0,"show":"transparent","border":0,"image":"%%IMG3AAoACgbAkWlIIgGOgFGJJCyZkMvisoQ0KU3MkTE5FJJMVKIQywQwp1ort8QmObtfIvjr/F5LSlIQ","brush":4,"scale":16}
button1:{"type":"button","size":[60,20],"pos":[442,32],"script":"same game.4","text":"reset"}
score:{"type":"slider","size":[60,25],"pos":[442,62],"locked":1,"interval":[0,9801],"value":10,"format":"score: %i","style":"bar"}

{script:same game.0}
SLEEP:2
W:c.lsize[0]
H:c.lsize[1]

on reset do
 score.value:0
 c.scale:16 c.lsize:10,10
 b:image[c.lsize]
 b.pixels: 35+random@(prod c.lsize) take 4
 c.paste[b]
end

on flood c xy new old do
 old: c[xy] unless old     sleep[SLEEP]
 if !old=new
  c[xy]:new n:1 # n=number of pixels changed
  neighbors: "%j" parse "[[0 1][1 0][0 -1][-1 0]]"
  each pt in neighbors + list xy
   # list xy == very important!!
   if prod (-1<pt) & pt<c.lsize
    if c[pt]=old n:n+flood[c pt new old] end
   end
  end
  n
 end
end

on column x do
 raze c.copy[x,0 1,H].pixels
end

on fall do
 # move unsupported blocks down by a single pixel
 f:1 # falling?
 while f  f:0
  sleep[SLEEP]
  each x in range W
   packed:1 # assume the best 
   each v i in col: rev column[x]
    if packed & v=0 packed:0 end
    if (!packed) f:f|o:col[i+1]  c[x,H-i+1]:o end
   end
  end
 end
end

on shrink do
 # move empty columns to the left
 done:0
 each x in range W
  while (0=sum column[x]) & !done
   xy:(x+1),0 wh:(W-x),H
   b: c.copy[xy wh]
   c.paste[b x,0]
   done: 0=sum raze b.pixels
   sleep[SLEEP]
  end
 end 
end

# make sure the grid is locked or you'll draw on it
# and mess up the data!
on click xy do
 if old:c[xy]
  n:flood[c xy 32 old]
  if n=1 sleep[SLEEP] c[xy]:old # revert
  else
   score.value:score.value + (n-1)^2
   flood[c xy 0]
   fall[]
   shrink[]
  end
 end
end
{end}

{script:same game.1}
on click do
  go["Prev" "SlideRight" 15]
end
