{script:home.0}
on pt_in_box pt xy wh do
 prod (pt>xy-1) & (pt<xy+wh+1)
end

on mouse_over w do
 pt_in_box[pointer.pos w.pos w.size]
end

on view do
 if mouse_over[me] c.pos: (first pointer.pos),(last me.pos) end
end
{end}

