{script:home.1}

on view do
 app.cursor: crosshair
 me.pos: me.pos + gamepad.dir

 me.pattern: colors.red o:me.size/2
 a: heading pointer.pos - (o+me.pos)
 me.clear[] me.brush:2 me.line[o o+10*unit a]
 me.pattern: colors.lightgray me.brush: 4
 me.line[o]
end
