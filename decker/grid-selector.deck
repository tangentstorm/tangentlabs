tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"locked":1,"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["In a  ","click"," event the offset into the canvas is calculated for us.\n\nWe still have to divide to get grid coordinates.\n\nThe ","y"," value tells us how many rows are above us, and ","x"," says how many are to the left. We need ","x +  y * gw"," to get the total count of cells \"before\" the clicked one.\n\nBut notice: all along, we're able to keep ","x"," and ","y"," together in the list ","xy",". That's the array programming style!"],"font":["","","","","","","","","","","","","","",""],"arg":["","","","","","","","","","","","","","",""],"pat":[1,33,1,33,1,33,1,33,1,33,1,33,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"locked":1,"show":"invert","value":"cw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\ncs: cw,ch c.clear[]\n\neach gxy in (gw cross gh)\n xy: cs*gxy  c.pattern:1\n c.text[\"%i,%i\" format gxy\n        cs*gxy+0.5 \"center\"]\n c.box[xy cs+1]\nend"},"prevBtn":{},"runBtn":{"show":"invert"},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
special:{"type":"button","size":[48,17],"pos":[449,176],"font":"body","pattern":40,"text":"special"}
current:{"type":"contraption","size":[59,21],"pos":[447,61],"volatile":1,"show":"transparent","def":"hybridSlider","widgets":{"compact":{"size":[59,21],"interval":[0,41],"value":21},"bar":{"size":[33,21],"interval":[0,41],"value":21}}}
currentLabel:{"type":"field","size":[55,13],"pos":[449,45],"locked":1,"show":"transparent","border":0,"style":"plain","align":"center","value":"current:"}

{script:grid coordinates to index.0}
on view do
 d.pos: pointer.pos-c.pos
 d.cs: (_cw,_ch)..value
 d.xy: floor d.pos/d.cs
 d.gw: _gw.value
 d.ix: sum d.xy * 1,d.gw
 me.text: 1 drop "
on click pos do         # %[pos]j
 cs: (_cw,_ch)..value   # %[cs]j
 xy: floor pos/cs       # %[xy]j
 gw: _gw.value          # %[gw]j
 ix: sum xy * 1,gw      # %[ix]j
 current.value: ix
end"
   format d
end

{end}

