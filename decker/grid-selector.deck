{deck}
version:1
card:0
size:[512,342]
script:"0"
name:"grid-selector.deck"

{script:0}
on run text do
 d:deck.card.widgets
 d.card:deck.card
 r:eval[deck.card.script d 1]
 if r.error
  alert[r.error]
 else
  d:r.vars
  r:eval[text d 1]
 end
 if "res" in keys d
   d.res.data: r.value unless r.error
 end
end

{end}

