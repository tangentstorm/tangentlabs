{script:grid scale.0}
on view do
 redraw[]
end

on redraw do
 c.clear[] c.pattern:colors.magenta c.fill[]
 w: first c.size h: last c.size  s:cs.value
 each xy in s * (w/s) cross h/s
  c.pattern:colors.green c.rect[xy s,s]
  c.pattern:colors.black c.box[xy s,s]
 end
end
{end}

{script:grid scale.1}

on drag pos do
 h.pos: me.pos + me.size
end

{end}

{script:grid scale.2}
on change val do
 redraw[]
end
{end}

{script:grid scale.3}
on view do
 d.p0: pointer.pos
 d.p1: d.p0-c.pos
 d.p2: d.p1/cs.value
 d.p3: floor d.p2
 me.text: 1 drop "
p0: pointer.pos   # %[p0]j 
p1: p0-c.pos      # %[p1]j
p2: p1/cs.value   # %[p2]j
p3: floor p2      # %[p3]j" 
  format d
end
{end}

{script:grid scale.4}
# handle script

on drag pos do
 if prod c.pos < me.pos
   c.size: me.pos - c.pos
 else
   me.pos: c.pos
 end
 redraw[]
end

{end}

