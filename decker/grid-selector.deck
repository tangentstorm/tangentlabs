{script:help.0}
on set_pattern x do
 (pal,patternSlider)..value:x
 (c0,c1)..pattern: x
end

on set_brush x do
 (brush,brushSlider)..value: x
 (c0,c1)..brush:x
end

on view do
 set_pattern[1]
 set_brush[0]
end
{end}

{script:help.1}
on change val do
 set_pattern[val]
end
{end}

{script:help.2}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  # .line[single_point] = draw brush
  c.brush:i c.line[cwh*xy+.5]
 end
end

on pick xy val do
 set_brush[val]
end
{end}

{script:help.3}
on change val do
 set_brush[val]
end
{end}

{script:help.4}
on click do
 go["Back" "SlideDown" 15]
end
{end}

