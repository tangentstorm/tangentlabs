tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["can you use what you've learned in other lessons to draw a grid?\n\nThe ","help"," button links to a card with more example code."],"font":["","",""],"arg":["","",""],"pat":[1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"cw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\nc.clear[] c.pattern:1\n\n# some of these lines might help:\nw:gw*cw   h:gh*ch\nc.box[90,20 cw,ch]\nc.rect[120,20 cw,ch]\neach x in cw * range 5\n  c.line[gw+x,0 c.size]\nend"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
