field3:{"type":"field","size":[263,53],"pos":[10,25],"animated":1,"script":"grid scale.3","border":0,"style":"code","value":"p0: pointer.pos   # [93,82] \np1: p0-c.pos      # [-200,25]\np2: p1/cs.value   # [-14.285714,1.785714]\np3: floor p2      # [-15,1]"}
