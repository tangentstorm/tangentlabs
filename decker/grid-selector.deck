field3:{"type":"field","size":[262,108],"pos":[4,59],"locked":1,"script":"drawing the cursor.2","border":1,"style":"code","value":"on view do\n #...\n each xy i in #...\n  c.pattern:\n    if i=current.value colors.blue\n    else colors.cyan end\n  c.rect[2+xy cs-2]\n end\nend"}

{script:drawing the cursor.0}
on view do
 cw:_cw.value ch:_ch.value
 gw:_gw.value gh:_gh.value
 cs: cw,ch c.clear[]
 each xy i in
   (gw cross gh) * list cs
  c.pattern:1 c.box[xy cs+1]
  c.pattern:
    if i=current.value colors.blue
    else colors.cyan end
  c.rect[2+xy cs-2]
 end
end
{end}

{script:drawing the cursor.1}
on change val do
 view[] 
end
{end}

