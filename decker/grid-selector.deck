currentLabel:{"type":"field","size":[55,13],"pos":[449,45],"locked":1,"show":"transparent","border":0,"style":"plain","align":"center","value":"current:"}
field3:{"type":"field","size":[262,108],"pos":[4,59],"locked":1,"volatile":1,"border":1,"style":"code"}

{script:drawing the cursor.0}
on view do
 cw:_cw.value ch:_ch.value
 gw:_gw.value gh:_gh.value
 cs: cw,ch c.clear[]
 each xy i in
   (gw cross gh) * list cs
  c.pattern:1 c.box[xy cs+1]
  c.pattern:
    if i=current.value colors.blue
    else colors.cyan end
  c.rect[2+xy cs-2]
 end
end
{end}

{script:drawing the cursor.1}

on click pos do
 xy: floor pos/(_cw,_ch)..value
 current.value: sum xy * 1,_gw.value
 view[]
end
{end}

{script:drawing the cursor.2}
on change val do
 view[] 
end
{end}

