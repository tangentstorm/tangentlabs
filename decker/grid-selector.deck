{script:behold the gridSelector!.0}
on view do
 bullet:image["%%IMG3AAgACAZAgHBIfBlfQyPrZBS+liemM3oyIQHGatN5JHoBQQ=="]
 card_names: extract key
   where !value..name in ("help",deck.card.name,"cleanup","thank you!")
   from deck.cards
 tutor1.body: #rtext.make["contents:\n" "menu" nil 0],
  raze each cn in card_names
    rtext.make["" "" bullet],
    rtext.make["  "],
    rtext.make[("%s\n" format cn) "mono" cn]
  end
end

{end}

{script:behold the gridSelector!.1}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  c.pattern:i c.rect[cwh*xy cwh]
 end
end

on pick xy i do
 set_pattern[i]
end
{end}

{script:behold the gridSelector!.2}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  # .line[single_point] = draw brush
  c.brush:i c.line[cwh*xy+.5]
 end
end

on pick xy val do
 brushSlider.value: val
 c.brush: val
end
{end}

{script:behold the gridSelector!.3}
on draw c do
 each gxy i in me.gw cross me.gh
  xy:me.cwh * gxy +0.5
  c.pattern: if i=me.value colors.red else colors.white end 
  c.rect[gxy*me.cwh me.cwh]
  c.pattern: if i=me.value colors.white else colors.black end
  c.text["%a" format 128+i xy "center"]
 end
end
{end}

{script:behold the gridSelector!.4}
on draw c do
 each gxy i in me.gw cross me.gh
  if i=me.value
   c.pattern: colors.darkgreen
   c.rect[gxy*me.cwh me.cwh]
  end 
  c.pattern: 1
  xy:me.cwh * gxy +0.5
  c.text[i xy "center"]
 end
end
{end}

{script:behold the gridSelector!.5}

on draw c do
  X: image[
"%%IMG3ABIAEgZAwCgAKBqPxaFwpEQemcMAlOhcRgFSJvWp3WabyS7yS51uj2RztfgVr9nqd3gqt5Lf5rszrjfG4Vp+bmh0f2NmV29SAUSMdVhEQQ=="]
  O:image[
"%%IMG3ABIAEgZAgFB4KhpPgaGSeDwml4Cm9Dl0Bq4BZ9V4VWa5US51+C2Wu1DAGZxmItltLjwtN7fdZWRcrF1a1X1uSFR5UoNLhX9QiYdtWI9jAEE="]
 icons: (nil,X,O)@me.data
 each gxy i in me.gw cross me.gh
  xy:1+me.cwh * gxy
  c.paste[icons[i].copy[] xy+1]
 end
end

on pick gxy ix do
 d:me.data
 d[ix]: 3 % d[ix]+1
 me.data:d
end

{end}

{script:behold the gridSelector!.6}
on click pos do
 go["https://www.youtube.com/playlist?list=PLQ_SPWX2XIsw"] 
end

{end}

{card:challenge{c} draw a grid}
