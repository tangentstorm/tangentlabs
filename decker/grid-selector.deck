tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["You now know everything you need to understand the ","gridSelector"," contraption. Try adding one now:\n\n- ","Tool"," > ","Widgets","\n- ","Widgets"," > ","New Contraption...","\n- select ","gridSelector"," and click ","Create",".\n\nIt  draws a grid and cursor, but you can add a ","draw"," handler to draw anything you like before that."],"font":["","","","","","","","","","","","","","","","",""],"arg":["","","","","","","","","","","","","","","","",""],"pat":[1,33,1,39,1,39,1,39,1,39,1,39,1,39,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"# try setting the gridSelector's\n# script to this:\n\non draw c do\n each gxy i in me.gw cross me.gh\n  xy:me.cwh * gxy +0.5\n  c.text[\n    \"%a\" format 64+i\n    xy \"center\"]\n end\nend"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
