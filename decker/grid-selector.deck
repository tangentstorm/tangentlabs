{card:why use cross?}
image:"%%"
{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["The ","each xy i in w cross h","  pattern makes it easy to draw each cell individually.\n\nNote the ","i",". While ","xy"," contains a pair of grid coordinates at each step, ","i"," contains the loop index - a count of how many cells we've drawn.\n\nWhy multiply by ","list cs"," instead of ","cs","? Try removing it and making the cells rectangular instead of square...\n\nWe'll cover Lil's \"conforming\" rules another time. For now, just use ","list","."],"font":["","","","","","","","","","","","","","",""],"arg":["","","","","","","","","","","","","","",""],"pat":[1,33,1,33,1,33,1,33,1,33,1,33,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"cw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\ncs: cw,ch c.clear[]\neach xy i in\n   (gw cross gh) * list cs\n c.pattern:i c.rect[2+xy cs-2]\n c.pattern:1 c.box[xy cs+1]\n c.pattern:0 c.rect[1+xy 13,11]\n c.pattern:1\n c.text[i (8,6)+xy \"center\"]\n sleep[1]\nend"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
c:{"type":"canvas","size":[167,147],"pos":[275,20],"volatile":1,"border":1,"scale":1}
