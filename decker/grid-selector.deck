{script:help.0}
on set_pattern x do
 (pal,patternSlider)..value:x
 (c0,c1)..pattern: x
end

on set_brush x do
 (brush,brushSlider)..value: x
 (c0,c1)..brush:x
end

on view do
 set_pattern[1]
 set_brush[0]
end
{end}

{script:help.1}
on change val do
 set_pattern[val]
end
{end}

{script:help.2}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  # .line[single_point] = draw brush
  c.brush:i c.line[cwh*xy+.5]
 end
end

on pick xy val do
 set_brush[val]
end
{end}

{script:help.3}
on change val do
 set_brush[val]
end
{end}

{script:help.4}
on click do
 go["Back" "SlideDown" 15]
end
{end}

{card:cleanup}
image:"%%"
script:"cleanup.0"
{widgets}
field1:{"type":"field","size":[255,252],"pos":[0,36],"pattern":46,"border":0,"scrollbar":0,"style":"plain","value":"# clean up positions of widgets on tutorial decks\nW:nil\nK: extract value\n  where !value..name in ( \"help\",\"skip\",\"cleanup\")\n  from deck.cards  \n\neach k in K\n  each w in k.widgets\n   if w.name=\"special\" w.show:\"none\" end\n    if w.name in W\n       d:W[w.name]\n       w.pos:d.pos\n       w.size:d.size\n    else\n       d:0\n      d.pos: w.pos\n      d.size: w.size\n      W[w.name]:d\n   end\n end\nend\n"}
res:{"type":"field","size":[256,75],"pos":[0,293],"volatile":1,"pattern":44,"show":"invert","border":0,"style":"plain"}
cardName1:{"type":"contraption","size":[132,14],"pos":[23,19],"def":"cardName","widgets":{"cn":{"size":[132,14],"value":"cleanup"}}}
prevBtn:{"type":"button","size":[20,15],"pos":[0,18],"script":"cleanup.1","font":"body","text":"<<"}
nextBtn:{"type":"button","size":[20,15],"pos":[157,18],"script":"cleanup.2","font":"body","text":">>"}
newBtn:{"type":"button","size":[20,15],"pos":[236,18],"script":"cleanup.3","font":"body","text":"+"}
g:{"type":"grid","size":[246,210],"pos":[263,20],"volatile":1,"show":"invert","widths":[20,140]}
script:{"type":"field","size":[207,103],"pos":[261,235],"locked":1,"volatile":1,"show":"invert","style":"code"}
button1:{"type":"button","size":[37,20],"pos":[472,236],"script":"cleanup.4","text":"go"}
clearBtn:{"type":"button","size":[38,20],"pos":[471,264],"script":"cleanup.5","text":"clear"}
special:{"type":"button","size":[40,17],"pos":[471,319],"font":"body","pattern":40,"text":"special"}

{script:cleanup.0}
on click do
 c:deck.cards[g.rowvalue.name]
 script.text:c.script
end

on view do
 g.value: select
  index
  name: value..name
  scripted: !!value..script
  special: !!value..widgets.special
 from deck.cards
 click[]
end

on cards_to_wipe do
 extract value..name
 where !value..widgets.special
 from deck.cards
end

# run this manually to completely reset the tutorial
on wipe_cards do
 each c in deck.cards@cards_to_wipe[]
  c.remove["tutor1" drop c.widgets]
  c.script:""
 end
end

{end}

{script:cleanup.1}
on click do
  go["Prev" "SlideRight" 15]
end
{end}

{script:cleanup.2}
on click do
  go["Next" "SlideLeft" 15]
end
{end}

{script:cleanup.3}
on click do
 go[deck.add[deck.card]]
 res.text:"new card"
end
{end}

{script:cleanup.4}
on click do
 go[g.rowvalue.name]
end

{end}

{script:cleanup.5}
on click do
 if g.rowvalue.special
   alert["refusing to clear scripts on special cards"]
 else
   c:deck.cards[g.rowvalue.name]
   c.script:""
   view[]
 end
end

{end}

{contraption:tutor}
size:[512,160]
resizable:1
margin:[5,140,4,8]
description:"A contraption for creating interactive decker tutorials.\n\nchangelog\n0.3: add help config, scrolling, resize and recolor\n0.2: add help button \n0.1: initial version"
version:0.3
image:"%%"
script:"tutor.0p"
attributes:{"name":["body","scroll_body","code","scroll_code","next","prev","help"],"label":["body","scroll body","code","scroll code","next card","prev card","help card"],"type":["rich","bool","code","bool","string","string","string"]}
{widgets}
body:{"type":"field","size":[210,124],"pos":[3,33],"locked":1,"pattern":44,"show":"transparent","border":0,"scrollbar":0,"value":"..."}
nextBtn:{"type":"button","size":[60,20],"pos":[445,35],"script":"tutor.1p","pattern":39,"text":"next>","style":"rect"}
cardName:{"type":"field","size":[504,20],"pos":[3,7],"locked":1,"volatile":1,"font":"menu","show":"transparent","border":0,"style":"plain"}
code:{"type":"field","size":[218,125],"pos":[222,32],"pattern":47,"show":"none","border":1,"scrollbar":0,"style":"code","scroll":1}
prevBtn:{"type":"button","size":[60,20],"pos":[445,58],"script":"tutor.2p","pattern":39,"text":"<prev","style":"rect"}
runBtn:{"type":"button","size":[60,20],"pos":[445,105],"script":"tutor.3p","pattern":0,"show":"none","text":"run","style":"rect"}
next:{"type":"field","size":[100,20],"pos":[4,-31],"locked":1,"show":"none","style":"plain","value":"Next"}
prev:{"type":"field","size":[100,20],"pos":[121,-31],"locked":1,"show":"none","style":"plain","value":"Prev"}
helpBtn:{"type":"button","size":[60,20],"pos":[445,81],"script":"tutor.4p","pattern":39,"show":"none","text":"help","style":"rect"}
help:{"type":"field","size":[100,20],"pos":[239,-31],"locked":1,"show":"none","style":"plain"}
scroll_body:{"type":"button","size":[15,20],"pos":[5,175],"locked":1,"show":"none","style":"check","value":0}
scroll_code:{"type":"button","size":[15,20],"pos":[80,175],"locked":1,"show":"none","style":"check","value":0}

{script:tutor.0p}
on get_body do body.value end  on set_body x do body.value: x end
on get_code do code.text end   on set_code x do code.text: x end
on get_next do next.text end   on set_next x do next.text: x end
on get_prev do prev.text end   on set_prev x do prev.text: x end
on get_help do help.text end   on set_help x do help.text: x end
on get_scroll_code do scroll_code.value end
on get_scroll_body do scroll_body.value end
on set_scroll_code x do scroll_code.value:x end
on set_scroll_body x do scroll_body.value:x end

on view do
 cardName.text: deck.card.name
 code.scrollbar: scroll_code.value
 body.scrollbar: scroll_body.value
 code.locked: me.locked
 sh: if code.text
       if me.locked "invert" else "solid" end
     else "none" end
 code.show: sh runBtn.show: sh
 nextBtn.show: if next.text "solid" else "none" end
 prevBtn.show: if prev.text "solid" else "none" end
 helpBtn.show: if help.text "solid" else "none" end
end

on next_card_name do
 if next.text = "Next"
  cn:keys deck.cards
  ci:first extract index where value=deck.card.name from cn
  cn[ci+1]
 else
  next.text
 end
end

on no_script c do
 (c.script="on view do\n\nend") |!c.script
end

on is_special c do
 "special" in keys c.widgets
end

on copy_to_next do
 card: deck.card
 if !is_special[card]
  nc: deck.cards[next_card_name[]]
  if !is_special[nc]
   tw: "tutor1"
   if ! count tw drop nc.widgets
    each w in tw drop card.widgets nc.add[w] end
   end
   if no_script[nc] nc.script: card.script end
  end
 end
end

on run text do
 d:deck.card.widgets
 d.card: deck.card
 eval[text d 1]
end

{end}

{script:tutor.1p}
on click do
 copy_to_next[]
 go[next.text "SlideLeft" 15]
end
{end}

{script:tutor.2p}
on click do
 go[prev.text "SlideRight" 15]
end
{end}

{script:tutor.3p}
on click do
 d:deck.card.widgets
 d.card:deck.card
 eval[code.text d 1]
end

{end}

{script:tutor.4p}
on click do
 go["help" "SlideUp" 15]
end
{end}

{contraption:hybridSlider}
size:[100,25]
resizable:1
margin:[19,6,17,6]
description:"Provides a slider with a combination of the \"bar\" and \"compact\" styles."
script:"hybridSlider.0p"
template:"on change val do\n \nend"
attributes:{"name":["minv","maxv","format","value"],"label":["min value","max value","format","value"],"type":["number","number","string","number"]}
{widgets}
compact:{"type":"slider","size":[100,25],"pos":[0,0],"script":"hybridSlider.1p","interval":[0,100],"style":"compact"}
bar:{"type":"slider","size":[74,25],"pos":[13,0],"script":"hybridSlider.2p","interval":[0,100],"style":"bar"}

{script:hybridSlider.0p}
on get_value do bar.value end       on set_value x do bar.value: x end
on get_format do bar.format end     on set_format x do bar.format: x end
on get_minv do bar.interval[0] end  on set_minv x do bar.interval:x,get_minv[] end
on get_maxv do bar.interval[1] end  on set_maxv x do bar.interval:get_maxv[],x end

on view do
 compact.interval: bar.interval
 compact.value:bar.value
end

{end}

{script:hybridSlider.1p}
on change val do
 bar.value:val
 card.event["change" val]
end

{end}

{script:hybridSlider.2p}
on change val do
 compact.value:val
 card.event["change" val]
end

{end}

{contraption:gridSelector}
size:[128,128]
resizable:1
margin:[2,1,2,2]
description:"Draws a rectangular grid with a cursor, and translates mouse events to grid coordinates."
version:0.1
script:"gridSelector.0p"
template:"on pick gxy ix do\nend\n\non draw c do\n each gxy i in me.gw cross me.gh\n  xy:me.cwh * gxy +0.5\n  c.text[i xy \"center\"]\n end\nend"
attributes:{"name":["cw","ch","gp","gw","gh","data","showCursor","dragToDraw","autoResize"],"label":["cell width","cell height","grid pattern","grid width","grid height","data","draw cursor?","drag to draw?","auto resize?"],"type":["number","number","number","number","number","data","bool","bool","bool"]}
{widgets}
cellW:{"type":"slider","size":[54,25],"pos":[158,-46],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
cellH:{"type":"slider","size":[54,25],"pos":[158,-3],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
c:{"type":"canvas","size":[128,128],"pos":[0,0],"locked":1,"volatile":1,"pattern":32,"show":"transparent","border":0,"scale":1}
gridP:{"type":"slider","size":[54,25],"pos":[158,40],"locked":1,"interval":[0,47],"value":9,"style":"compact"}
curXY:{"type":"field","size":[54,20],"pos":[158,76],"locked":1,"style":"plain","value":"[0,0]"}
gridW:{"type":"slider","size":[54,25],"pos":[224,-46],"locked":1,"interval":[1,1024],"value":8,"style":"compact"}
gridH:{"type":"slider","size":[54,25],"pos":[224,-3],"locked":1,"interval":[1,1024],"value":8,"style":"compact"}
showCursor:{"type":"button","size":[60,20],"pos":[225,40],"locked":1,"font":"body","text":"cursor?","style":"check","value":1}
dragToDraw:{"type":"button","size":[60,20],"pos":[225,76],"locked":1,"font":"body","text":"drag to draw?","style":"check","value":1}
autoResize:{"type":"button","size":[60,20],"pos":[224,107],"locked":1,"font":"body","text":"auto resize?","style":"check","value":1}
data:{"type":"field","size":[104,46],"pos":[-133,0],"locked":1,"border":0,"style":"plain"}

{script:gridSelector.0p}
on get_cwh do cellW.value,cellH.value end
on get_gwh do gridW.value,gridH.value end

on resize do
 # add 1 to size for outermost border/cursor drawing
 if autoResize.value card.size: 1+get_cwh[] * get_gwh[] end
end

on get_cw do cellW.value end     on set_cw x do cellW.value: x resize[] end
on get_ch do cellH.value end     on set_ch x do cellH.value: x resize[] end
on get_gw do gridW.value end     on set_gw x do gridW.value: x resize[] end
on get_gh do gridH.value end     on set_gh x do gridH.value: x resize[] end
on get_gp do gridP.value end     on set_gp x do gridP.value: x resize[] end

# data just lets you store arbitrary state (ex: game board, etc)
on get_data do data.data end     on set_data x do data.data: x view[] end

on get_autoResize   do autoResize.value   end
on set_autoResize x do autoResize.value:x end
on get_showCursor   do showCursor.value   end
on set_showCursor x do showCursor.value:x end
on get_dragToDraw   do dragToDraw.value   end
on set_dragToDraw x do dragToDraw.value:x end

on get_cxy    do curXY.data end
on set_cxy xy do curXY.data: xy view[] end
on get_value   do sum get_cxy[] * 1,get_gw[] end
on set_value i do
 gw:get_gw[] curXY.data: (gw%i),(floor i/gw)
 view[]
end
  
on view do
 c.clear[]
 # draw background (0 and 1 are swapped)
 c.pattern: if card.pattern>1 card.pattern else 1-c.pattern end c.fill[]
 c.brush:0 c.pattern:1
 # give instances a chance to draw on canvas
 card.event["draw" c] c.brush:0 c.pattern: gridP.value
 if gridP.value
  w:prod(gridW,cellW)..value h:prod(gridH,cellH)..value
  each x in get_cw[] * range 1+get_gw[] c.line[x,0 x,h] end nil
  each y in get_ch[] * range 1+get_gh[] c.line[0,y w,y] end nil
 end
 if showCursor.value
  xy:curXY.data  cwh:get_cwh[]
  c.brush: c.pattern:1  c.box[xy*cwh 1+cwh]
  c.brush: 0 c.pattern:32 c.box[xy*cwh cwh]
 end
end

on click xy do
 set_cxy[floor xy/get_cwh[]]
 card.event["pick" get_cxy[] get_value[]]
 card.event["drag" xy]
end

on drag xy do
 if dragToDraw.value click[xy] end
 card.event["drag" xy]
end

on release xy do
 card.event["release" xy]
end

{end}

