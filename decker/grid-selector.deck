{card:the scaled canvas trick}
image:"%%"
script:"the scaled canvas trick.0"
{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":"Our next goal is to detect clicks on individual grid cells.\n\nA scaled canvas can do part of this out of the box. You could put a transparent one over anything to detect clicks.\n\nSince we want an all-in-one contraption, and our cells might not be square, we'll do the calculations ourselves."},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"c.scale:9 c.lsize:16,16\nc.clear[] c.pattern:colors.red\n\n# draw some random pixels\n# so we can see the grid size\nbg:colors@\"lightgray\",\n  \"mediumgray\",\"darkgray\"\nim:image[c.lsize]\nim.pixels:bg@ random@ \n  (prod c.lsize) take 3\nc.paste[im]\n"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
c:{"type":"canvas","size":[167,147],"pos":[275,20],"volatile":1,"scale":9}
field3:{"type":"field","size":[262,108],"pos":[4,59],"locked":1,"border":1,"style":"code","value":"on click pos do\n f.text:\"last click: %i,%i\" format pos\nend"}
special:{"type":"button","size":[48,17],"pos":[449,176],"font":"body","pattern":40,"show":"none","text":"special"}
f:{"type":"field","size":[127,15],"pos":[124,25],"volatile":1,"show":"transparent","border":0}
clearBtn:{"type":"button","size":[60,20],"pos":[446,20],"script":"the scaled canvas trick.1","text":"clear","style":"rect"}
interlude:{"type":"field","size":[100,20],"pos":[4,22],"locked":1,"show":"transparent","border":0,"value":{"text":["","interlude"],"font":["","menu"],"arg":["",""]}}

{script:the scaled canvas trick.0}
on click pos do
 f.text:"last click: %i,%i" format pos
end
{end}

{script:the scaled canvas trick.1}
on click do
 c.clear[] c.brush:0 c.pattern:1
 f.text:""
end
{end}

{card:pointer coordinates}
image:"%%"
{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"locked":1,"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["The ","pointer"," interface represents  mouse or touch input. It's updated on each new frame.\n\nThe field above is flagged as animated so it gets a ","view[]"," event every frame.\n\nIn it, we subtract the canvas position from the pointer position to get an offset into the canvas."],"font":["","","","",""],"arg":["","","","",""],"pat":[1,33,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"locked":1,"show":"invert","value":"# run this to draw a grid\ncw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\ncs: cw,ch c.clear[]\n\neach gxy in (gw cross gh)\n xy: cs*gxy  c.pattern:1\n c.text[\"%i,%i\" format gxy\n        cs*gxy+0.5 \"center\"]\n c.box[xy cs+1]\nend"},"prevBtn":{},"runBtn":{"show":"invert"},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
