canvas:{"type":"field","size":[299,251],"pos":[2,20],"locked":1,"border":0,"value":{"text":["","canvas quick reference","\n\n","c.pattern: 0      # number or colors.red\nc.brush: 0\n\nc.clear[]\nc.fill[xy]        # paint bucket tool\nc.box[xy wh]      # outline only\nc.rect[xy wh]     # outline + fill\nc.line[..xy]\nc.text[msg pos a]\n# a is optional, and can be any of:\n#\n# \"top_left\"    \"top_center\"    \"top_right\"\n# \"center_left\" \"center\"        \"center_right\"\n# \"bottom_left\" \"bottom_center\" \"bottom_right\"\n\nc.copy[xy wh]     # gives an image\nc.paste[img xy t] # if t=1 color 0 is transparent\nc.merge[op? ..im] # op can be any of: \"+-*&|<>=\"\n\nFor more, see ","#canvasinterface"," in docs"],"font":["","menu","","mono","mono","mono"],"arg":["","","","","https://beyondloom.com/decker/decker.html#canvasinterface",""]}}
