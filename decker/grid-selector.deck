{script:challenge{c} draw a grid.0}
on click do
 c.clear[] c.brush:0 c.pattern:1
end
{end}

{card:drawing with lines}
image:"%%"
{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["Here's how I'd draw it by hand:\n\nFirst, draw each horizontal line.\n\nThen draw each vertical one.\n\nNote there is 1 more horizontal line than the number of rows, and 1 more vertical line than the number of columns.\n\nThe"," sleep[n]"," calls wait for n frames before continuing the loop - an easy way to make simple animations!"],"font":["","",""],"arg":["","",""],"pat":[1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"cw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\nw:gw*cw   h:gh*ch\n\nc.clear[] c.pattern:1\neach y in ch * range 1+gh\n c.line[0,y w,y] sleep[2]\nend\n\neach x in cw * range 1+gw\n c.line[x,0 x,h] sleep[2]\nend"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
