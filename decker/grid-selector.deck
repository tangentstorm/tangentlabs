{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"locked":1,"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["To convert the raw pointer offset (","p0",") into a grid cell, we can simply divide by the cell size.\n\nThe phrase ","(_cw,_ch)"," is simply a list of our two slider widgets. Adding ","..value"," is shorthand for:\n\n","each x in (_cw,_ch)\n  x.value\nend\n","\nAfter division (","/","), The word ","floor"," rounds the result down to the nearest integer."],"font":["","","","","","","","","","","","",""],"arg":["","","","","","","","","","","","",""],"pat":[1,33,1,33,1,33,1,33,1,33,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"locked":1,"show":"invert","value":"# run this to draw a grid\ncw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\ncs: cw,ch c.clear[]\n\neach gxy in (gw cross gh)\n xy: cs*gxy  c.pattern:1\n c.text[\"%i,%i\" format gxy\n        cs*gxy+0.5 \"center\"]\n c.box[xy cs+1]\nend"},"prevBtn":{},"runBtn":{"show":"invert"},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
