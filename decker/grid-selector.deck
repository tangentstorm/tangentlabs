{script:pointer to grid coordinates.0}
on view do
 d.p0: pointer.pos-c.pos
 d.cs: (_cw,_ch)..value
 d.p1: floor d.p0/d.cs
 me.text: 1 drop "
on view do
 p0: pointer.pos-c.pos  # %[p0]j 
 cs: (_cw,_ch)..value   # %[cs]j
 p1: floor p0/cs        # %[p1]j
end"
   format d
end
{end}

