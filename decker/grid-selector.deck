{script:card2.0}
on set_pattern x do
 (pal,patternSlider)..value:x
 (c0,c1)..pattern: x
end

on set_brush x do
 (brush,brushSlider)..value: x
 (c0,c1)..brush:x
end
{end}

{script:card2.1}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  c.pattern:i c.rect[cwh*xy cwh]
 end
end

on pick xy i do
 set_pattern[i]
end
{end}

{script:card2.2}
on change val do
 set_pattern[val]
end
{end}

{script:card2.3}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  # .line[single_point] = draw brush
  c.brush:i c.line[cwh*xy+.5]
 end
end

on pick xy val do
 brushSlider.value: val
 c.brush: val
end
{end}

{script:card2.4}
on change val do
 set_brush[val]
end
{end}

