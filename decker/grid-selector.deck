{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["Above: to draw a cursor, we can just compare the loop index to the current value, and do something special when we draw that cell.\n\nRight: we can also go back later and calculate the cell's position from the current index.\n\nNote that \"n modulo k\" is  ","k % n"," in lil - backwards from many other languages.\n\nDrawing the cursor as nested black and white boxes helps it stay visible no matter how the grid contents look."],"font":["","",""],"arg":["","",""],"pat":[1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"ix: current.value\ngw: _gw.value\nxy: (gw%ix), floor ix/gw\ncs: (_cw,_ch)..value\n\nc.pattern:1 c.box[1+xy*cs cs-1]\nc.pattern:0 c.box[2+xy*cs cs-2]"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
