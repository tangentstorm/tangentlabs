ghLabel:{"type":"field","size":[77,14],"pos":[138,38],"locked":1,"show":"transparent","border":0,"style":"plain","align":"right","value":"grid height (gh):"}
cwLabel:{"type":"field","size":[75,14],"pos":[2,20],"locked":1,"show":"transparent","border":0,"style":"plain","align":"right","value":"cell width (cw):"}
chLabel:{"type":"field","size":[75,14],"pos":[2,38],"locked":1,"show":"transparent","border":0,"style":"plain","align":"right","value":"cell height (ch):"}
_gw:{"type":"slider","size":[47,14],"pos":[218,20],"interval":[5,25],"value":8,"style":"compact"}
_gh:{"type":"slider","size":[47,14],"pos":[218,38],"interval":[5,25],"value":8,"style":"compact"}
