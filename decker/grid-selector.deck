{script:pointer coordinates.0}
on view do
 d.p0: pointer.pos
 d.p1: d.p0 - c.pos
 me.text: 1 drop "
on view do
 p0: pointer.pos        # %[p0]j
 p1: p0-c.pos           # %[p1]j
end" 
  format d
end
{end}

