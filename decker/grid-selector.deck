{card:drawing with rectangles}
image:"%%"
{widgets}
tutor1:{"type":"contraption","size":[512,172],"pos":[0,170],"def":"tutor","widgets":{"body":{"size":[210,136],"value":{"text":["Another option is to use ","cross"," to make a single loop through each pair of grid coordinates.\n\nIf you leave the ","sleep[]"," calls in, you'll see it's quite a bit slower: ","gw*gh","  steps, instead of ","gw+gh",".\n\nHowever, normally we wouldn't put ","sleep[]"," in our drawing code, and without it, it's still very fast for actual grids.\n"],"font":["","","","","","","","","","",""],"arg":["","","","","","","","","","",""],"pat":[1,33,1,33,1,33,1,33,1,33,1]}},"nextBtn":{},"cardName":{},"code":{"size":[218,137],"value":"cw:_cw.value ch:_ch.value\ngw:_gw.value gh:_gh.value\ncs: cw,ch c.clear[]\n\neach xy in (gw cross gh) * list cs\n c.pattern:1\n c.box[xy cs+1]\n c.pattern:colors.cyan\n c.rect[2+xy cs-2] sleep[2]\nend"},"prevBtn":{},"runBtn":{},"next":{},"prev":{},"helpBtn":{},"help":{"value":"help"},"scroll_body":{"pos":[5,187]},"scroll_code":{"pos":[80,187]}}}
