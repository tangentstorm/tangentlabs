{deck}
version:1
card:1
size:[256,200]
name:"timer.deck"
locked:1

{card:home}

{card:canvas and grid}
image:"%%"
script:"canvas and grid.0"
{widgets}
c:{"type":"canvas","size":[200,120],"pos":[27,30],"animated":1,"font":"mono","pattern":38,"border":1,"image":"%%IMG3ADIAHgZAgHBILBqPyKRyyWw6n9CodEqtWq/YrHbL7Xq/4LD4aCoPy6Yk+mxGroVv+BmQlsPrdbreTsfP84B3e219dmZ4gH6FiH96aY9kjpJ5RJCWe4WOikVtj5uVfp1zcoGCmJB8oqSjd4mUhHFxmX2uY7a3uLm6u7y9vr/AwVRB","brush":4,"scale":4}
f:{"type":"field","size":[153,19],"pos":[26,180],"font":"menu","show":"none","value":"13430540930560.892578"}
startBtn:{"type":"button","size":[44,21],"pos":[127,154],"font":"body","text":"start","style":"rect"}
stopBtn:{"type":"button","size":[48,20],"pos":[179,154],"script":"canvas and grid.1","font":"body","text":"stop","style":"rect"}
minutes:{"type":"slider","size":[89,20],"pos":[27,154],"interval":[1,60],"value":1,"format":"minutes: %i","style":"bar"}

{script:canvas and grid.0}
MINUTE: 60*1000

on click do
 f.data: sys.ms + MINUTE*minutes.value
end

on view do
 t: (f.data - sys.ms) | 0
 m: floor t / MINUTE
 s: (MINUTE % t)/1000
 ms: (1000 % t)/10
 c.clear[] c.pattern:colors.blue
 c.text["%02i:%02i:%02i" format m,s,ms
   c.lsize/2 "center"] 
end

{end}

{script:canvas and grid.1}
on click do
 f.data: sys.ms
end
{end}

{contraption:cardName}
size:[100,20]
resizable:1
margin:[0,0,0,0]
description:"show / edit the current card name"
script:"cardName.0p"
{widgets}
cn:{"type":"field","size":[100,20],"pos":[0,0],"show":"transparent","border":0,"style":"plain","value":"card7"}

{script:cardName.0p}
on view do
 cn.text: deck.card.name
end

on change val do
 deck.card.name: cn.text
end
{end}

