{script:home.0}
A:"%a" format list 97+range 26

on click do
 msg.text: ""
 if !letter.value ~ me.label
  msg.text: "bad"
 end
end


on run text do
 d:card.widgets
 r:eval[text d 1]
 result.value: show[r.value unless r.error]
end

{end}

{script:home.1}
on change val do
 
end
{end}

{script:home.2}

on view do
 c.paste[app.render[bc]]
end

{end}

{script:home.3}
on change val do
 
end

on view do
 me.text:" " fuse 
  extract value..text
  where each b in (app.render@value) b[2,2]=1 end
  where value..type="button"
  from card.widgets
end
{end}

