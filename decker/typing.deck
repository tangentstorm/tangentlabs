{script:game.0}
bgN:34 # arne red
bgY:42 # arne dark green
bgX:0
bgF:colors.black

# this fires at start of page
on loop do
 welcome.show:"transparent"
 setbg[bgX "" 1] wd.pos:220,130 wd.text:"go" 
 pause.value: 0 speed.value:0
 0 # loop returns a sound clip to loop
end

on setbg x m p do
 c.pattern:x
 c.rect[0,0 c.size]
 c.pattern:0 unless p
 c.text[m (0,-c.scale)+c.lsize/2 "center"]
 bg.value:20
end

on new_word do
 wd.text: "" fuse rev " ",random[" " split words.text]
 wd.pos: (24,24) | random[first card.size-wd.size],0
end

on good_msg do
 r:random[" " split "good great correct yes awesome"]
 "" fuse r,"!"
end

on nope_msg do
 random["try again", " " split "whoops nope sorry nah wrong"]
end

on good k do
 setbg[bgY good_msg[]] new_word[]
 welcome.show:"none"
 speed.value:speed.value+1
end
on nope k do
 setbg[bgN nope_msg[]]
end

on view do
 # bg just constantly loops
 if !bg.value:bg.value-1 setbg[bgX] bg.value:20 end
 if (speed.value>0) & !((last speed.interval)-speed.value) % bg.value
  if (last card.size) < last wd.pos: wd.pos + 0,2
   setbg[bgF random[">8(", "FAIL"]] new_word[]
  end
 end
end

{end}

{script:game.1}
on click do
 bg.animated: !speed.locked: me.value
end
{end}

{script:game.2}
on key_dn k do
 wd.key: k
end

on key_up k do
end

{end}

{script:game.3}
on click do
 deck.locked: me.value
end
{end}

