{script:v0.game.0}
bgN:colors.red
bgY:colors.green
bgX:colors.white
bgF:colors.black

on loop do
 bg.animated: 1 pause.value: 0
 inputCopy.text:"" new_word[] 0
 setbg[bgX "type the words" 1]
end

on setbg x m p do
 c.pattern:x
 c.rect[0,0 c.size]
 c.pattern:0 unless p
 c.text[m (0,-c.scale)+c.lsize/2 "center"]
 bg.value:20
end

on new_word do
 w.text: random[" " split words.text]
 w.pos: random[first card.size-w.size],0
end

on good do
 r:random[" " split "good great correct yes awesome"]
 "" fuse r,"!"
end

on nope do
 random["try again", " " split "whoops nope sorry nah wrong"]
end

on run do
 t: last extract where !value="" from " " split input.text
 inputCopy.text:t input.text:""
 if t=w.text
  setbg[bgY good[]] new_word[]
 else
  setbg[bgN nope[]]
 end
end

on view do
 # bg just constantly loops
 if !bg.value:bg.value-1 setbg[bgX] bg.value:20 end
 if (speed.value>0) & !(10-speed.value) % bg.value
  if (last card.size) < last w.pos: w.pos + 0,1
   setbg[bgF random[">8(", "FAIL"]] new_word[]
  end
 end
end

{end}

{script:v0.game.1}
on drag pos do
 
end


{end}

{script:v0.game.2}
on click do
 alert["that's not part of the game!"]
end
{end}

{card:word drawing test}
image:"%%"
script:"word drawing test.0"
{widgets}
c:{"type":"canvas","size":[132,60],"pos":[27,39],"locked":1,"volatile":1,"script":"word drawing test.1","font":"menu","pattern":44,"show":"transparent","border":0,"scale":1}
pal:{"type":"contraption","size":[81,61],"pos":[63,259],"volatile":1,"script":"word drawing test.2","def":"gridSelector","widgets":{"cellW":{"pos":[111,-46],"value":10},"cellH":{"size":[54,13],"pos":[111,-3],"value":10},"c":{"size":[81,61]},"gridColor":{"size":[54,12],"pos":[111,19],"value":1},"curXY":{"size":[61,9],"pos":[111,39],"value":"[2,4]"},"gridW":{"pos":[177,-46],"value":8},"gridH":{"size":[54,13],"pos":[177,-3],"value":6},"showCursor":{"size":[60,10],"pos":[178,19]}}}
patternSlider:{"type":"slider","size":[43,20],"pos":[19,287],"volatile":1,"script":"word drawing test.3","interval":[0,47],"style":"bar"}
_wd:{"type":"field","size":[58,20],"pos":[281,40],"volatile":1,"script":"word drawing test.4","border":1,"style":"code"}
_t:{"type":"grid","size":[91,206],"pos":[419,114],"volatile":1}
_key:{"type":"field","size":[43,20],"pos":[346,39],"animated":1,"volatile":1}
field1:{"type":"field","size":[108,64],"pos":[27,142],"pattern":39,"show":"invert","border":0,"value":{"text":["","card for testing the per-character state (stored in"," ","_t",") and the drawing logic."],"font":["","","","",""],"arg":["","","","",""],"pat":[1,40,1,42,40]}}

{script:word drawing test.0}
on set_word w do 
 _wd.text:s:trim w
 _t.value: select ch:value st:0 fc:0 from s
 _t.row: 0
 c.font: "menu" c.clear[]
 view[]
end

on set_pattern x do
 (pal,patternSlider)..value:x
end

on view do
 if !_wd.text set_word.word end

 OK:5,4,3,2,1 BAD:-3,-2,-1 FC:8
 ix:_t.row T:_t.value
 
 # keypress handler
 if key:_key.text
  _key.text:""
  T.fc[ix]:FC # start an animation
  T.st[ix]:
   if key=T.ch[ix]
     _t.row:ix+1 OK[0]
   else BAD[0] end
 end
 
 # frame counters:
 T:update fc:FC st:st-1 where (st>1) & !fc from
   update fc:FC st:st+1 where (st<0) & !fc from
   update fc:fc-1 where fc from T
  
 x:1 p:(0,OK,BAD) dict (44,39,32,46,45,41,35,34,37)

 c.clear[] # draw letters:
 c.scale:1 c.size: c.textsize["" fuse T.ch]+2
 each row in rows T
  c.pattern:p[row.st]
  c.text[row.ch x,0 "top_left"]
  x:x+first c.textsize[row.ch]
 end
 
 a:c.copy[].scale[4]
 c.size: c.lsize*4
 b:a.copy[].map[0 dict 0 1]
 each xy in 3 cross 3 c.paste[b xy] end
 c.paste[a 1,1 1]
  
 _t.value:T
end
{end}

{script:word drawing test.1}
on click pos do
 
end

on drag pos do
 
end

on release pos do
 
end
{end}

{script:word drawing test.2}
on draw c do
 cwh:me.cwh
 each xy i in me.gw cross me.gh
  c.pattern:i c.rect[cwh*xy cwh]
 end
end

on pick xy i do
 set_pattern[i]
end
{end}

{script:word drawing test.3}
on change val do
 set_pattern[val]
end
{end}

{script:word drawing test.4}
on change val do
 set_word[val] 
end
{end}

