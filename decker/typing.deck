{script:initial keyboard version.0}
A:"%a" format list 97+range 26

on click do
 msg.text: ""
 if !letter.value ~ me.label
  msg.text: "bad"
 end
end

{end}

{script:initial keyboard version.1}

on run text do
 d:card.widgets
 r:eval[text d 1]
 result.value: show[r.value unless r.error]
end

{end}

{script:initial keyboard version.2}

on view do
 prev:me.text
 me.text:"" fuse 
  extract value..text
  where each b in (app.render@value) b[2,2]=1 end
  where value..type="button"
  from card.widgets
  prev:"ab" text:"bc"
  dn:extract where !("" split text) in prev from text 
  up:extract where !("" split prev) in text from prev
end

{end}

