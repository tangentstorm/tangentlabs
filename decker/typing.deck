bk1:{"type":"button","size":[15,15],"pos":[119,18],"font":"mono","pattern":0,"text":"k","shortcut":"k"}
bl:{"type":"button","size":[15,15],"pos":[135,18],"font":"mono","pattern":0,"text":"l","shortcut":"l"}
bz1:{"type":"button","size":[15,15],"pos":[12,34],"font":"mono","pattern":0,"text":"z","shortcut":"z"}
bx:{"type":"button","size":[15,15],"pos":[28,34],"font":"mono","pattern":0,"text":"x","shortcut":"x"}
bc:{"type":"button","size":[15,15],"pos":[44,34],"font":"mono","pattern":0,"text":"c","shortcut":"c"}
bv1:{"type":"button","size":[15,15],"pos":[60,34],"font":"mono","pattern":0,"text":"v","shortcut":"v"}
bb:{"type":"button","size":[15,15],"pos":[76,34],"font":"mono","pattern":0,"text":"b","shortcut":"b"}
bn:{"type":"button","size":[15,15],"pos":[92,34],"font":"mono","pattern":0,"text":"n","shortcut":"n"}
bm:{"type":"button","size":[15,15],"pos":[108,34],"font":"mono","pattern":0,"text":"m","shortcut":"m"}
spacebar:{"type":"button","size":[79,15],"pos":[47,51],"pattern":0}
qwerty:{"type":"field","size":[56,34],"pos":[244,10],"locked":1,"value":"qwertyuiop\nasdfghjkl\nzxcvbnm"}
dvorak:{"type":"field","size":[59,35],"pos":[244,-36],"locked":1,"value":"...pyfgcrl\naoeuidhtns\n.qjkxbmwvz"}
_k:{"type":"field","size":[171,20],"pos":[1,-54],"locked":1,"animated":1,"volatile":1,"font":"menu"}
which:{"type":"field","size":[57,16],"pos":[244,-75],"locked":1,"script":"keyboard.1p","style":"plain","value":"qwerty"}

{script:keyboard.0p}
# note: you can't rearrange the widgets in an individual
# contraption, so you have to rearrange the prototype.
# therefore, the keyboard configuration is global
on ME do deck.contraptions.keyboard end
on MW do ME[].widgets end

layouts: qwerty, dvorak

on get_layout do MW[].which.text end
on set_layout x do
 if x in names:layouts..name MW[].which.text:x layout[]
 else alert["layout must be in: {l}%s{r}" format ", " fuse names] end
end

on layout do
 buttons: extract value
  where value..type="button"
  from MW[]
  show[buttons]

 # arrange buttons according to layout
 x:x0:y:2 cw:15 gy:0 
 i:0 each ch in MW[][get_layout[]].text
  b:buttons[i]
  # b.font:"mono" b.size:2 take cw
  if ch="\n" 
   gy:gy+1 y:y+cw+1
   x:x0+(gy*cw/3)
  elseif ch="."
   x:x+cw+1
  else
   b.pos:x,y x:x+cw+1
   b.name: "b%s" format ch
   b.text:ch b.shortcut:ch
   i:i+1
  end
 end
 ME[].update[]
end

on view do
 text: "" fuse
  extract value..text
  where each b in (app.render@value) b[2,2]=1 end
  where value..type="button"
  from MW[]
 spacebar.show:
  if sp: gamepad.held.action > "n" in text
    text: "" fuse " ",text
    "invert" else "solid"
  end
 # now: which are new?
 prev:_k.text
 each up in extract where !("" split prev) in text from prev
  card.event["key_up" up]
 end
 each dn in extract where !("" split text) in prev from text
  card.event["key_dn" dn]
 end
 _k.text: text
end
{end}

{script:keyboard.1p}
on change val do
 layout[]
end
{end}

{contraption:gridSelector}
size:[128,128]
resizable:1
margin:[2,1,2,2]
description:"Draws a rectangular grid with a cursor, and translates mouse events to grid coordinates."
version:0.1
script:"gridSelector.0p"
attributes:{"name":["cw","ch","gc","gw","gh","cursor"],"label":["cell width","cell height","grid color","grid width","grid height","draw cursor?"],"type":["number","number","number","number","number","bool"]}
{widgets}
cellW:{"type":"slider","size":[54,25],"pos":[158,-46],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
cellH:{"type":"slider","size":[54,25],"pos":[158,-3],"locked":1,"interval":[4,100],"value":16,"style":"compact"}
c:{"type":"canvas","size":[128,128],"pos":[0,0],"locked":1,"volatile":1,"pattern":32,"show":"transparent","border":1,"scale":1}
gridColor:{"type":"slider","size":[54,25],"pos":[158,40],"locked":1,"interval":[0,47],"value":9,"style":"compact"}
curXY:{"type":"field","size":[61,20],"pos":[158,81],"locked":1,"style":"plain","value":"[2,1]"}
gridW:{"type":"slider","size":[54,25],"pos":[224,-46],"locked":1,"interval":[1,1024],"value":16,"style":"compact"}
gridH:{"type":"slider","size":[54,25],"pos":[224,-3],"locked":1,"interval":[1,1024],"value":16,"style":"compact"}
showCursor:{"type":"button","size":[60,20],"pos":[225,40],"locked":1,"font":"body","text":"cursor?","style":"check","value":1}

{script:gridSelector.0p}
on get_cw do cellW.value end     on set_cw x do cellW.value: x end
on get_ch do cellH.value end     on set_ch x do cellH.value: x end
on get_gw do gridW.value end     on set_gw x do gridW.value: x end
on get_gh do gridH.value end     on set_gh x do gridH.value: x end
on get_gp do gridP.value end     on set_gp x do gridP.value: x end
on get_showCursor   do showCursor.value   end
on set_showCursor x do showCursor.value:x end

on get_cxy do curXY.data end       on set_cxy xy do curXY.data: xy end
on get_cwh do cellW.value,cellH.value end
on get_value do (get_gw[] * last curXY.data) + first curXY.data end
on set_value i do
 gw:get_gw[] curXY.data: (gw%i),(floor i/gw)
 view[]
end
  
on view do
 c.clear[] c.brush:0 c.pattern:1
 # give instances a chance to draw on canvas
 card.event["draw" c] c.brush:0 c.pattern: gridColor.value
 if gridColor.value
  each x in get_cw[] * range 1+get_gw[] c.line[x,0 x,c.size[1]] end nil
  each y in get_ch[] * range 1+get_gh[] c.line[0,y c.size[0],y] end nil
 end
 if showCursor.value
  xy:curXY.data  cwh:get_cwh[]
  c.brush: c.pattern:1  c.box[xy*cwh 1+cwh]
  c.brush: 0 c.pattern:32 c.box[xy*cwh cwh]
 end
end
on drag xy do click[xy] end
on click xy do
 set_cxy[floor xy/get_cwh[]]
 view[]
 card.event["pick" get_cxy[] get_value[]]
end
{end}

{contraption:progressWord}
size:[268,68]
margin:[0,0,0,0]
description:"The word or text you're supposed to type in the game. Fills up like a progressbar as you set the .key attribute."
script:"progressWord.0p"
attributes:{"name":["text","scale"],"label":["text","scale"],"type":["string","number"]}
{widgets}
c:{"type":"canvas","size":[152,52],"pos":[0,0],"locked":1,"volatile":1,"font":"mono","pattern":41,"show":"transparent","border":0,"scale":1}
_wd:{"type":"field","size":[58,20],"pos":[5,-36],"script":"progressWord.1p","border":1,"style":"code","value":"hello "}
_t:{"type":"grid","size":[96,118],"pos":[275,-1],"locked":1,"value":{"ch":["h","e","l","l","o"," "],"st":[1,1,1,1,1,5],"fc":[0,0,0,0,0,3]},"row":6}
_key:{"type":"field","size":[43,20],"pos":[70,-37],"animated":1,"script":"progressWord.2p","value":" "}
_scale:{"type":"slider","size":[49,17],"pos":[8,-66],"locked":1,"script":"progressWord.3p","interval":[1,16],"value":4,"style":"bar"}

{script:progressWord.0p}
# event names names
EGOOD:"good" ENOPE:"nope"

on get_text do _wd.text end
on set_text w do 
 _wd.text:s:"" fuse rev " ",trim w
 _t.value: select ch:value st:0 fc:0 from s
 _t.row: 0
 c.font: me.font c.clear[]
 view[]
end

on set_scale x do _scale.value: x end
on get_scale x do _scale.value end

OK:5,4,3,2,1 BAD:-3,-2,-1 FC:3

on get_key do "" end
on set_key k do
 ix:_t.row
 if k
  T:_t.value
  T.fc[ix]:FC # start an animation
  T.st[ix]:
   if k=T.ch[ix]
     _t.row:ix+1 OK[0]
   else card.event[ENOPE k] BAD[0] end
  _t.value:T
  if prod T.st>0 card.event[EGOOD "" fuse T.ch] end 
 end
end

on view do
 T:_t.value
 # frame counters:
 T:update fc:FC st:st-1 where (st>1) & !fc from
   update fc:FC st:st+1 where (st<0) & !fc from
   update fc:fc-1 where fc from T
  
 x:1 p:(0,OK,BAD) dict (44,39,32,46,45,41,35,34,37)

 c.clear[] # draw letters:
 c.scale:1 c.size: c.textsize["" fuse T.ch]+2 
 each row in rows T
  c.pattern:p[row.st]
  c.text[row.ch x,0 "top_left"]
  x:x+first c.textsize[row.ch]
 end
 
 a:c.copy[].scale[_scale.value]
 c.size: c.lsize*_scale.value
 b:a.copy[].map[0 dict 0 1]
 each xy in 3 cross 3 c.paste[b xy] end
 c.paste[a 1,1 1]
  
 _t.value:T
end
{end}

{script:progressWord.1p}
on change val do
 set_text[val] 
end
{end}

{script:progressWord.2p}
on change val do
 set_key[val]
end

{end}

{script:progressWord.3p}
on change val do
 view[]
end
{end}

